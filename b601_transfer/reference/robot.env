# Settings for robot.sh. Edit freely; robot.sh sources this file.

# Devices
LEADER_PORT=/dev/so101_leader     # udev symlink from root-setup.sh (falls back to /dev/ttyACM0)
LEADER_ID=so101_leader
FOLLOWER_PORT=can0
FOLLOWER_ID=b601_rs

# OAK device IDs (MXIDs). Fill in from: bash robot.sh cameras
WRIST_OAK_ID=19443010A13F095A00   # OAK-D-SR
OVERVIEW_OAK_ID=19443010A155785A00  # OAK-1-AF
# OAK-D SR has no CAM_A; its color sensors are CAM_B (left) / CAM_C (right).
WRIST_SOCKET=CAM_B
WRIST_SIZE="width: 640, height: 400"      # OV9782 is 16:10
OVERVIEW_SIZE="width: 640, height: 480"
OVERVIEW_ROTATION=0                        # 0, 90, 180 or -90 if the camera is mounted rotated
CAMERA_FPS=30
# mjpeg = encode on the OAK, decode here. Needed if the OAKs link at USB 2 (HIGH).
CAMERA_ENCODING=mjpeg

# B601 wrist_yaw has no SO-101 counterpart; it is held here (degrees).
WRIST_YAW_DEG=0
# Max follower joint change per control step (degrees). 5 deg at 30 Hz = 150 deg/s.
MAX_RELATIVE_TARGET=5

# Dataset
HF_USER=local                     # set to your Hugging Face username before pushing
DATASET_NAME=b601_pick_place
TASK="Pick up the cube and place it in the bowl"
NUM_EPISODES=50
EPISODE_TIME_S=30
RESET_TIME_S=15
DATASET_ROOT="$HOME/robot-setup/datasets"
# h264 encodes far faster than the default libsvtav1 on this 4-core CPU.
VCODEC=h264
